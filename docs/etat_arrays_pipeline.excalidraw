    {
      "id": "exp1-txt",
      "type": "text",
      "x": 905,
      "y": 405,
      "width": 265,
      "height": 231,
      "angle": 0,
      "strokeColor": "#7c3d00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
